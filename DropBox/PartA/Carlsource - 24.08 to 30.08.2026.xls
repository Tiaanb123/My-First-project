		<Row ss:AutoFitHeight="1">
			<Cell ss:Index="1" ss:StyleID="45" ss:MergeAcross="14">
				<Data ss:Type="String">Reported: The newly added SL111c PE2 began causing an operational or system error immediately after installation.</Data>
			</Cell>
		</Row>
		<Row ss:AutoFitHeight="1">
			<Cell ss:Index="1" ss:StyleID="45" ss:MergeAcross="14">
				<Data ss:Type="String">Remedy:  A request was made to disable SL111c PE2 directly within the PLC/software code to resolve the disturbance.</Data>
			</Cell>
		</Row>
		<Row ss:AutoFitHeight="1">
			<Cell ss:Index="1" ss:StyleID="45" ss:MergeAcross="14">
				<Data ss:Type="String"> </Data>
			</Cell>
		</Row>
		<Row ss:AutoFitHeight="1">
			<Cell ss:Index="1" ss:StyleID="45" ss:MergeAcross="14">
				<Data ss:Type="String">29/08: </Data>
			</Cell>
		</Row>
		<Row ss:AutoFitHeight="1">
			<Cell ss:Index="1" ss:StyleID="45" ss:MergeAcross="14">
				<Data ss:Type="String">The project team added SL111c PE2 last night, and it was causing an issue. Requested to disable it in the code.</Data>
			</Cell>
		</Row>
		<Row ss:AutoFitHeight="1">
			<Cell ss:Index="1" ss:StyleID="50" ss:MergeDown="3">
				<Data ss:Type="String">•</Data>
			</Cell>
			<Cell ss:Index="2" ss:StyleID="51" ss:MergeAcross="13">
				<Data ss:Type="String">Trigger:</Data>
			</Cell>
		</Row>
		<Row ss:AutoFitHeight="1">
